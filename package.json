{
  "name": "markwright",
  "version": "0.1.0",
  "description": "Markwright crafts polished Word documents from raw markdown.",
  "license": "MIT",
  "keywords": [
    "word",
    "office-addin",
    "markdown",
    "office-js"
  ],
  "homepage": "https://github.com/brian-benzinger/markwright#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brian-benzinger/markwright.git"
  },
  "bugs": {
    "url": "https://github.com/brian-benzinger/markwright/issues"
  },
  "bin": {
    "markwright": "bin/markwright.mjs"
  },
  "files": [
    "bin",
    "dist",
    "manifest.xml"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "sideload": "npx --yes office-addin-debugging@latest start manifest.xml desktop --app word --no-debug --dev-server \"npm run dev-server\" --dev-server-port 3000",
    "sideload:stop": "npx --yes office-addin-debugging@latest stop manifest.xml",
    "validate": "npx --yes office-addin-manifest@latest validate manifest.xml",
    "lint": "eslint . && prettier --check src tests *.mjs *.json",
    "lint:fix": "eslint . --fix && prettier --write src tests *.mjs *.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "markdown-it": "^14.3.0",
    "office-addin-dev-certs": "^2.0.10"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/office-js": "^1.0.600",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.10",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-office-addins": "^4.0.10",
    "globals": "^15.15.0",
    "html-webpack-plugin": "^5.6.8",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.7",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^5.2.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
