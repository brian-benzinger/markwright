{
  "name": "markwright",
  "version": "0.1.0",
  "description": "Markwright crafts polished Word documents from raw markdown.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "validate": "office-addin-manifest validate manifest.xml",
    "lint": "eslint . && prettier --check src tests *.mjs *.json",
    "lint:fix": "eslint . --fix && prettier --write src tests *.mjs *.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/office-js": "^1.0.377",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-office-addins": "^4.0.9",
    "globals": "^15.15.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-dev-certs": "^2.0.9",
    "office-addin-manifest": "^2.1.5",
    "prettier": "^3.8.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.7",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
